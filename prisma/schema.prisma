// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum MenuCategory {
  COFFEE
  TEA
  PASTRY
  FOOD
  SPECIALS
}

model MenuItem {
  id          String       @id @default(cuid())
  name        String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  category    MenuCategory
  imageUrl    String?
  isAvailable Boolean      @default(true)
  isFeatured  Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]
}

enum MediaSource {
  GIT
  BLOB
}

enum MediaCategory {
  DISH
  AMBIENCE
  HERO
  ABOUT
  GALLERY
  LOGO
  OTHER
}

model MediaAsset {
  id        String         @id @default(cuid())
  url       String
  source    MediaSource    @default(BLOB)
  category  MediaCategory  @default(OTHER)
  label     String?
  createdAt DateTime       @default(now())
}

enum GalleryPlacement {
  GALLERY
  HERO
  ABOUT
}

model GalleryImage {
  id        String           @id @default(cuid())
  imageUrl  String
  caption   String?
  placement GalleryPlacement @default(GALLERY)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
}

model Table {
  id        String    @id @default(cuid())
  label     String
  seats     Int       @default(2)
  shape     String    @default("square")
  x         Float     @default(10)
  y         Float     @default(10)
  createdAt DateTime  @default(now())
  bookings  Booking[]
  orders    Order[]
}

enum BookingStatus {
  BOOKED
  SEATED
  DONE
  CANCELLED
}

model Booking {
  id            String        @id @default(cuid())
  tableId       String
  table         Table         @relation(fields: [tableId], references: [id])
  customerName  String
  customerPhone String
  partySize     Int
  bookedFor     DateTime
  status        BookingStatus @default(BOOKED)
  seatedAt      DateTime?
  doneAt        DateTime?
  createdAt     DateTime      @default(now())

  @@index([customerPhone])
}

enum PaymentMode {
  COUNTER
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
}

enum OrderStatus {
  PLACED
  PREPARING
  SERVED
  CANCELLED
}

model Order {
  id                String        @id @default(cuid())
  customerName      String
  customerPhone     String
  tableId           String?
  table             Table?        @relation(fields: [tableId], references: [id])
  items             OrderItem[]
  total             Decimal       @db.Decimal(10, 2)
  status            OrderStatus   @default(PLACED)
  paymentMode       PaymentMode?
  paymentStatus     PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())

  @@index([customerPhone])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  name       String
  price      Decimal  @db.Decimal(10, 2)
  qty        Int
}

model SiteContent {
  id                     String   @id @default("main")
  cafeName               String   @default("Brew & Bloom")
  tagline                String   @default("Your daily dose of good vibes")
  heroText               String   @default("Sip. Vibe. Repeat.")
  aboutText              String   @default("A cozy corner for coffee lovers and dreamers.")
  address                String   @default("123 Main Street")
  phone                  String   @default("+1 555 123 4567")
  instagram              String?
  openingHours           String   @default("Mon–Sun: 9:00 AM – 11:00 PM")
  mapEmbedUrl            String?
  paymentGatewayEnabled  Boolean  @default(false)
  logoUrl                String?
  updatedAt              DateTime @updatedAt
}
